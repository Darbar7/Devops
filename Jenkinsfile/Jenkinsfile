pipeline {
    agent any
    
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        
        stage('Run Automated Tests') {
            steps {
                // Runs unit tests or skips cleanly if no test files exist yet
                sh 'python3 -m pytest || echo "No tests configured yet, skipping..."'
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("flask-ecommerce-app:${env.BUILD_NUMBER}")
                    docker.build("flask-ecommerce-app:latest")
                }
            }
        }
        
        stage('Deploy Locally with Docker Compose') {
            steps {
                sh 'docker-compose down || true'
                sh 'docker-compose up -d'
            }
        }
    }
}