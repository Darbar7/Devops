pipeline {
    agent any

    environment {
        IMAGE_NAME = 'naguru/ecommerce-backend'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Deploy to Kubernetes via Helm') {
            steps {
                script {
                    // Verifying helm and kubectl access
                    sh "helm upgrade --install ecommerce-release ./ecommerce-chart"
                }
            }
        }
    }
}